{
  "name": "crdb1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*", "/movie/*", "/tv/*", "/sitemap.xml", "/top-movies", "/top-tv"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "crdb-db", "database_id": "PASTE_DATABASE_ID_HERE" }
  ],
  "vars": {
    "TMDB_KEY": "5e11ae6a3daf0069b9c7c9f603bb2355"
  }
}
